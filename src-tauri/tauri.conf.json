{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nesting Studio",
  "version": "0.1.0",
  "identifier": "com.nestingstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nesting Studio",
        "width": 1500,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "fileAssociations": [
      { "ext": ["nesting"], "name": "Trabajo de Nesting Studio", "description": "Trabajo de Nesting Studio", "role": "Editor", "mimeType": "application/x-nesting-studio" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
